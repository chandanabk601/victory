# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=victory_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/victory_db

# Security & Authentication
JWT_SECRET=super_secure_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Key Management (Ed25519)
# Path to store private keys locally (outside database)
KEYS_STORAGE_DIR=./keys

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
